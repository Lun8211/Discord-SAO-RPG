# ==========================================
# Discord 設定
# ==========================================
# Discord 機器人 Token (從 Discord Developer Portal -> Bot 取得)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 預設要發送每日商店訊息的 Discord 文字頻道 ID (對頻道按右鍵 -> 複製頻道 ID)
DISCORD_CHANNEL_ID=123456789012345678

# (選用) 若想改用 Discord Webhook 發送，可填寫此欄
DISCORD_WEBHOOK_URL=

# ==========================================
# Riot Games / 特戰英豪 (VALORANT) 多人帳號設定
# (支援以下 3 種設定方式，任選一種最順手的即可)
# ==========================================

# 【方式 A：使用編號變數設定多個人帳號】(支援 _1 到 _20)
ACCOUNT_NAME_1=小明
RIOT_SSID_1=eyJhbGciOiJSUzI1NiIs...
# (選填) 填入對方的 Discord User ID，發送時會自動標註 @對方
DISCORD_USER_ID_1=
# (選填) 若某個帳號想發到不同頻道可個別指定，留空則發送到預設 DISCORD_CHANNEL_ID
DISCORD_CHANNEL_ID_1=

ACCOUNT_NAME_2=阿華
RIOT_SSID_2=eyJhbGciOiJSUzI1NiIs...
DISCORD_USER_ID_2=
DISCORD_CHANNEL_ID_2=

# 【方式 B：在 RIOT_ACCOUNTS (或 RIOT_SSID) 一次貼上多行】
# 每行一個帳號，格式支援：
#   純 ssid
#   暱稱|ssid
#   暱稱|ssid|Discord用戶ID
#   暱稱|ssid|Discord用戶ID|指定頻道ID
RIOT_ACCOUNTS=

# 【方式 C：單一帳號快速設定 (向下相容)】
RIOT_SSID=
RIOT_COOKIES=

# ==========================================
# 區域與語言設定
# ==========================================
# 預設伺服器分區 (台灣/亞太服請填 ap，美服 na，歐服 eu，韓服 kr)
RIOT_REGION=ap

# 造型顯示語言 (繁體中文: zh-TW, 簡體中文: zh-CN, 英文: en-US, 日文: ja-JP)
VALORANT_LANG=zh-TW

# (選用) 若使用 bot.py 常駐模式，每日自動推送的時間 (24小時制 HH:MM，預設台灣時間 08:05)
DAILY_POST_TIME=08:05
TIMEZONE_OFFSET_HOURS=8
