# ==========================================
# Discord 機器人設定（必填）
# ==========================================
# Discord 機器人 Token（從 Discord Developer Portal -> Bot 取得）
DISCORD_BOT_TOKEN=請貼上你的Discord機器人Token

# ==========================================
# 時區與 RPG 永久存檔設定（選填）
# ==========================================
# 每日簽到／任務重置時區偏移（台灣 / UTC+8 為 8）
TIMEZONE_OFFSET_HOURS=8

# RPG SQLite 資料庫路徑（預設 data/rpg.db，本地常駐重啟會自動記憶所有人進度）
RPG_DB_PATH=data/rpg.db

# （選填）若透過 GitHub Actions 或無本地硬碟雲端平台啟動機器人，
# 可建立一個「僅限管理員與機器人可見」的私有 Discord 文字頻道並填入頻道 ID，
# 機器人將於開機自動還原最新存檔、定時與關機前自動備份壓縮快照！
RPG_BACKUP_CHANNEL_ID=

# 自動備份間隔（分鐘，預設 15）
RPG_BACKUP_INTERVAL_MINUTES=15
