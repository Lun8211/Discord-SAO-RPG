# ==========================================
# Discord 設定
# ==========================================
# Discord 機器人 Token (從 Discord Developer Portal -> Bot 取得)
DISCORD_BOT_TOKEN=請貼上你的Discord機器人Token

# 預設要發送每日商店訊息的 Discord 文字頻道 ID (對頻道按右鍵 -> 複製頻道 ID)
DISCORD_CHANNEL_ID=請貼上你的Discord頻道ID

# ==========================================
# Riot Games / 特戰英豪 (VALORANT) 多人帳號設定
# (與你在 GitHub Secrets 填寫的格式完全相同！用雙引號包住即可)
# ==========================================
RIOT_SSID_1="Lun|貼上整串Cookie|你的Discord用戶ID"
RIOT_SSID_2="Mahiru|貼上整串Cookie|對方的Discord用戶ID"
RIOT_SSID_3="Bliz|貼上整串Cookie|對方的Discord用戶ID"
RIOT_SSID_4="Nakka|貼上整串Cookie|對方的Discord用戶ID"
RIOT_SSID_5="john|貼上整串Cookie|對方的Discord用戶ID"

# ==========================================
# 區域、語言與每日定時推送時間
# ==========================================
RIOT_REGION=ap
VALORANT_LANG=zh-TW
DAILY_POST_TIME=08:05
TIMEZONE_OFFSET_HOURS=8
