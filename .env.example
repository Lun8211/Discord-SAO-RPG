# ==========================================
# Sword Art Online: Aincrad 100-Floor RPG Bot 設定（必填）
# ==========================================
# Discord 機器人 Token（從 Discord Developer Portal -> Bot 取得）
DISCORD_BOT_TOKEN=請貼上你的Discord機器人Token

# ==========================================
# 時區與艾恩葛朗特永久存檔設定（選填）
# ==========================================
# 每日簽到／世界王次數重置時區偏移（台灣 / UTC+8 為 8）
TIMEZONE_OFFSET_HOURS=8

# SQLite WAL 資料庫路徑（預設 data/rpg.db，支援 v1->v2 無痛自動遷移）
RPG_DB_PATH=data/rpg.db

# （選填）私有 Discord 備份文字頻道 ID（僅限管理員與機器人可見），
# 設定後將於開機自動還原最新快照、定時與關機前自動上傳 Gzip 壓縮備份！
RPG_BACKUP_CHANNEL_ID=

# 自動備份間隔（分鐘，預設 15）
RPG_BACKUP_INTERVAL_MINUTES=15
