# ==========================================
# Discord 設定 (擇一或同時設定，建議使用 Bot Token + Channel ID)
# ==========================================
# Discord 機器人 Token (從 Discord Developer Portal -> Bot 取得)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 要發送每日商店訊息的 Discord 文字頻道 ID (對頻道按右鍵 -> 複製頻道 ID)
DISCORD_CHANNEL_ID=123456789012345678

# (選用) 若想改用 Discord Webhook 發送，可填寫此欄
DISCORD_WEBHOOK_URL=

# ==========================================
# Riot Games / 特戰英豪 (VALORANT) 帳號設定
# ==========================================
# 從瀏覽器登入 https://auth.riotgames.com 後取得的 ssid Cookie 值
RIOT_SSID=your_riot_ssid_cookie_here

# (選用) 完整 Cookie 字串 (例如 "ssid=...; clid=...; csid=...; sub=...; tdid=...")
# 若填寫 RIOT_COOKIES，優先使用此欄，可延長登入維持時間
RIOT_COOKIES=

# 伺服器分區 (台灣/亞太服請填 ap，美服 na，歐服 eu，韓服 kr)
# 若留空，程式會自動透過 Riot Geo API 偵測，失敗時預設使用 ap
RIOT_REGION=ap

# 造型顯示語言 (繁體中文: zh-TW, 簡體中文: zh-CN, 英文: en-US, 日文: ja-JP)
VALORANT_LANG=zh-TW

# (選用) 若使用 bot.py 常駐模式，每日自動推送的時間 (24小時制 HH:MM，預設台灣時間 08:05)
DAILY_POST_TIME=08:05
TIMEZONE_OFFSET_HOURS=8
